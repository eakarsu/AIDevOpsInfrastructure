NODE_ENV=development
DATABASE_URL=postgresql://devops_user:change-me@localhost:5432/ai_devops_infrastructure
JWT_SECRET=replace-with-at-least-32-random-characters
SERVER_PORT=3001
CLIENT_PORT=3000
CORS_ORIGINS=http://localhost:3000
ALLOWED_ENVIRONMENTS=sandbox
# Cloud/Kubernetes/IaC credentials must be short-lived and injected by a broker.
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
